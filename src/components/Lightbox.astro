---
// Image viewer: pictures in entry text (.prose) and photo links (an <a> to an image file wrapping
// an <img>) open enlarged on the page instead of leaving it. Links keep their href, so without JS
// they still open the file. Cards whose picture links to another page are left alone.
// Pictures on one page form a group: arrow keys or the side buttons move between them.
import type { Locale } from '../site.config';
import { t } from '../lib/i18n';
import Icon from './Icon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const L = t(locale);
---
<dialog class="lightbox" id="lightbox" aria-label={L.ui.close}>
  <button class="icon-btn lb-close" type="button" data-close aria-label={L.ui.close} title={L.ui.close}><Icon name="close" /></button>
  <button class="icon-btn lb-prev" type="button" data-step="-1" aria-label={L.ui.previous} title={L.ui.previous}><Icon name="chevron-left" /></button>
  <img alt="" />
  <button class="icon-btn lb-next" type="button" data-step="1" aria-label={L.ui.next} title={L.ui.next}><Icon name="chevron-right" /></button>
  <p class="lb-caption"></p>
</dialog>

<script>
  const box = document.getElementById('lightbox') as HTMLDialogElement;
  const view = box.querySelector('img')!;
  const caption = box.querySelector<HTMLElement>('.lb-caption')!;

  // A photo link opens its own target (usually a larger file); a plain picture opens itself
  const isImageFile = (url: string) => /\.(avif|webp|png|jpe?g|gif|svg)(\?|$)/i.test(url);
  const linkOf = (img: HTMLImageElement) => (img.parentElement instanceof HTMLAnchorElement ? img.parentElement : null);
  const pictures = [...document.querySelectorAll<HTMLImageElement>('.prose img, a > img')].filter((img) => {
    const link = linkOf(img);
    return !img.closest('.lightbox') && (!link || isImageFile(link.href));
  });
  const sourceOf = (img: HTMLImageElement) => linkOf(img)?.href || img.currentSrc || img.src;
  const captionOf = (img: HTMLImageElement) =>
    img.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || img.title || '';

  let index = 0;
  const show = (i: number) => {
    index = (i + pictures.length) % pictures.length;
    const img = pictures[index];
    view.src = sourceOf(img);
    view.alt = img.alt;
    caption.textContent = captionOf(img);
    caption.hidden = !caption.textContent;
    box.classList.toggle('single', pictures.length < 2);
  };

  pictures.forEach((img, i) => {
    img.classList.add('zoomable');
    img.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      box.showModal();
    });
  });

  box.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const step = t.closest<HTMLElement>('[data-step]');
    if (step) show(index + Number(step.dataset.step));
    else if (t.closest('[data-close]') || t === box) box.close(); // outside the picture = close
  });
  box.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    else if (e.key === 'ArrowRight') show(index + 1);
  });
  box.addEventListener('close', () => { view.removeAttribute('src'); });
</script>

<style is:global>
  .zoomable { cursor: zoom-in; }
  .lightbox {
    border: 0; padding: 0; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh;
    background: transparent; color: oklch(95% 0 0);
    display: none; align-items: center; justify-content: center;
  }
  .lightbox[open] { display: flex; }
  .lightbox::backdrop { background: oklch(10% 0 0 / 0.9); }
  .lightbox > img { max-width: calc(100vw - 2rem); max-height: calc(100vh - 2rem); width: auto; height: auto; object-fit: contain; border-radius: var(--radius); cursor: default; }
  .lightbox .icon-btn { position: absolute; color: inherit; opacity: 0.75; padding: 0.6rem; }
  .lightbox .icon-btn:hover { opacity: 1; color: inherit; }
  .lightbox .icon-btn .icon { width: 1.6em; height: 1.6em; }
  .lb-close { top: 0.75rem; right: 0.75rem; }
  .lb-prev { left: 0.5rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 0.5rem; top: 50%; transform: translateY(-50%); }
  .lightbox.single :is(.lb-prev, .lb-next) { display: none; }
  .lb-caption { position: absolute; bottom: 0.75rem; left: 1rem; right: 1rem; margin: 0; text-align: center; font-size: 0.875rem; opacity: 0.85; }
  .lb-caption[hidden] { display: none; }
</style>

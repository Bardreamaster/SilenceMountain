---
// Table of contents for an entry page (items from src/lib/toc.ts). Wide screens: a sticky panel
// beside the text. Narrow: a panel that the list button in EntryNav opens next to the buttons.
import type { tocItems } from '../lib/toc';
import { t } from '../lib/i18n';
import type { Locale } from '../site.config';

interface Props { locale: Locale; items: ReturnType<typeof tocItems> }
const { locale, items } = Astro.props;
const L = t(locale);
---
{items.length > 0 && (
  <nav class="toc" id="toc" aria-label={L.ui.toc} data-pagefind-ignore="all">
    <p class="toc-title">{L.ui.toc}</p>
    <ol>
      {items.map((h) => (
        <li class:list={{ sub: h.sub }}><a href={`#${h.slug}`}>{h.text}</a></li>
      ))}
    </ol>
  </nav>
)}

<script>
  const toc = document.getElementById('toc');
  const button = document.getElementById('entry-toc');
  if (toc) {
    // Mark the heading currently in view: the last one above the top quarter of the viewport
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const targets = [...byId.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    let current: HTMLAnchorElement | undefined;
    const update = () => {
      const line = innerHeight / 4;
      let best = targets[0];
      for (const el of targets) if (el.getBoundingClientRect().top <= line) best = el;
      if (!best) return;
      current?.removeAttribute('aria-current');
      current = byId.get(best.id);
      current?.setAttribute('aria-current', 'location');
    };
    addEventListener('scroll', update, { passive: true });
    update();

    // Narrow screens: the list button opens the panel; a pick, a click elsewhere or Esc closes it
    if (button) {
      button.hidden = false;
      const setOpen = (open: boolean) => {
        toc.classList.toggle('open', open);
        button.setAttribute('aria-expanded', String(open));
      };
      button.addEventListener('click', () => setOpen(!toc.classList.contains('open')));
      toc.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (!toc.contains(t) && !button.contains(t)) setOpen(false);
      });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    }
  }
</script>

<style is:global>
  .toc { font-size: 0.875rem; line-height: 1.5; }
  .toc-title { margin: 0; color: var(--muted); font-weight: 600; }
  .toc ol { list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .toc li { margin: 0.35em 0; }
  .toc li.sub { padding-left: 1em; }
  .toc a { color: var(--muted); text-decoration: none; }
  .toc a:hover, .toc a[aria-current] { color: var(--fg); }
  .toc a[aria-current] { font-weight: 600; }

  /* Narrow: a panel beside the floating buttons, shown by the list button (see EntryNav) */
  @media (max-width: 75.99rem) {
    .toc {
      display: none;
      position: fixed; z-index: 9;
      right: calc(1rem + 2.5rem + 0.75rem); bottom: 1.25rem;
      width: min(20rem, calc(100vw - 2rem - 2.5rem - 0.75rem));
      max-height: min(60vh, 28rem); overflow-y: auto;
      padding: 0.75rem 1rem;
      background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius);
      box-shadow: 0 4px 16px oklch(0% 0 0 / 0.12);
    }
    .toc.open { display: block; }
  }

  /* Wide: the entry stays centred and the list sits in the margin on the right, following the scroll */
  @media (min-width: 76rem) {
    .entry { position: relative; }
    .toc { position: absolute; top: 0; bottom: 0; left: calc(100% + 2.5rem); width: 14rem; }
    .toc > * { position: sticky; }
    .toc-title { top: 4.5rem; }
    .toc ol { top: calc(4.5rem + 1.5em + 0.5rem); max-height: calc(100vh - 8rem); overflow-y: auto; }
    .entry-nav .toc-btn { display: none; }
  }
</style>

---
import '../styles/global.css';
import site, { type Locale } from '../site.config';
import { defaultLocale, href, languageLinks, t } from '../lib/i18n';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  alternates?: Partial<Record<Locale, string>>;
  /** Set for articles so link previews show the right type */
  ogType?: 'website' | 'article';
  /** Share-card image; defaults to the language's generated card */
  ogImage?: string;
  /** Wider content area, for pages with a side panel */
  wide?: boolean;
  /** Articles: publication and update dates for search engines and link previews */
  published?: Date;
  modified?: Date;
  /** Keep the page out of search results */
  noindex?: boolean;
  /** Structured data (schema.org JSON-LD) describing the page */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { locale, title, description, alternates, ogType = 'website', ogImage = `/og/site/${locale}.png`, wide = false, published, modified, noindex, schema } = Astro.props;
const L = t(locale);
const fullTitle = title ? `${title} · ${L.title}` : L.title;
const desc = description ?? L.description;
const canonical = new URL(Astro.url.pathname, site.url).href;
// hreflang: every language this exact page exists in, plus x-default (the default language's)
const langs = Object.entries(languageLinks(Astro.url.pathname, locale, alternates)).filter(([, v]) => v.exact);
const xDefault = langs.find(([l]) => l === defaultLocale);
const ld = schema && JSON.stringify(Array.isArray(schema) ? schema : [schema]).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={L.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={L.author} />
    {!noindex && langs.length > 1 && langs.map(([l, v]) => (
      <link rel="alternate" hreflang={site.locales[l as Locale].htmlLang} href={new URL(v.url, site.url).href} />
    ))}
    {!noindex && langs.length > 1 && xDefault && <link rel="alternate" hreflang="x-default" href={new URL(xDefault[1].url, site.url).href} />}
    <link rel="alternate" type="application/rss+xml" title={L.title} href={href(locale, '/rss.xml')} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title ?? L.title} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={L.title} />
    <meta property="og:locale" content={L.htmlLang.replace('-', '_')} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="oklch(99% 0.003 95)" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="oklch(22% 0.016 310)" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply the saved theme before first paint to avoid a flash. window.name is a fallback
      // that survives navigation in the same tab where storage is blocked (e.g. sandboxed previews).
      (function () {
        var s;
        try { s = localStorage.getItem('theme'); } catch (e) {}
        if (!s) { var m = /(?:^|;)theme=(light|dark)/.exec(window.name); if (m) s = m[1]; }
        if (s) document.documentElement.dataset.theme = s;
      })();
    </script>
    {site.webFont && (
      <link id="webfont" rel="stylesheet" href={site.webFont.css} media="print" data-skip-when-saving={site.webFont.skipWhenSaving ? '' : undefined} />
    )}
    {site.webFont && (
      <script is:inline>
        // Turn the web font on unless the visitor is saving data. Without JS it stays off.
        (function () {
          var l = document.getElementById('webfont');
          var c = navigator.connection;
          var saving = c && (c.saveData || /2g/.test(c.effectiveType || '') || c.type === 'cellular');
          if (l.hasAttribute('data-skip-when-saving') && saving) l.remove();
          else l.media = 'all';
        })();
      </script>
    )}
    {ld && <script type="application/ld+json" set:html={ld} />}
    <slot name="head" />
  </head>
  <body>
    <Header locale={locale} alternates={Astro.props.alternates} wide={wide} />
    <main>
      <div class:list={["wrap", { wide }]}><slot /></div>
    </main>
    <Footer locale={locale} wide={wide} />
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', function () {
        var root = document.documentElement;
        var dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
        window.name = window.name.replace(/(?:^|;)theme=(light|dark)/, '') + ';theme=' + root.dataset.theme;
      });
    </script>
    {site.cloudflareAnalyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: site.cloudflareAnalyticsToken })}></script>
    )}
  </body>
</html>

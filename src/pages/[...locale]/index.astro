---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import { avatar } from '../../lib/avatar';
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import site from '../../site.config';
import { href, localeFromParam, localeParams, t } from '../../lib/i18n';
import { entriesIn } from '../../lib/content';
import { website } from '../../lib/schema';

export const getStaticPaths = localeParams;
const locale = localeFromParam(Astro.params.locale);
const L = t(locale);
const posts = (await entriesIn('posts', locale)).slice(0, site.homePostCount);
// Optional intro text: src/content/pages/<locale>/home.md
const intro = await getEntry('pages', `${locale}/home`);
const Intro = intro ? (await render(intro)).Content : null;
---
<Base locale={locale} schema={website(locale)}>
  {(Intro || avatar) && (
    <section class="intro">
      {avatar && <Image src={avatar} alt={L.author} width={96} height={96} class="avatar" loading="eager" />}
      {Intro && <div class="prose"><Intro /></div>}
    </section>
  )}
  <h2>{L.ui.recentPosts}</h2>
  <PostList posts={posts} locale={locale} />
  <p class="small"><a href={href(locale, '/posts/')}>{L.ui.allPosts} →</a></p>
</Base>

---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { localeFromParam, localeParams, t } from '../../../lib/i18n';
import { entriesIn } from '../../../lib/content';
import Filter from '../../../components/Filter.astro';
import { filterId } from '../../../lib/filter';

export const getStaticPaths = localeParams;
const locale = localeFromParam(Astro.params.locale);
const L = t(locale);
const entries = await entriesIn('life', locale);
const title = L.nav.find((n) => n.href === '/life/')?.label ?? 'Life';

const types = Object.keys(L.ui.lifeTypes) as (keyof typeof L.ui.lifeTypes)[];
const present = types.filter((ty) => entries.some((e) => e.data.type === ty));
const years = [...new Set(entries.map((e) => e.data.date.getUTCFullYear()))];
const compact = new Set(['book', 'film']);
const hasGlobe = entries.some((e) => e.data.coords);

// Hide years with nothing of the chosen type, in the list and in the year jump
const groupRules = present
  .map((ty) => `body:has(#${filterId('life', ty)}:checked) .life-year:not(:has([data-type="${ty}"])){display:none}`)
  .concat(years.flatMap((y) => present
    .filter((ty) => !entries.some((e) => e.data.type === ty && e.data.date.getUTCFullYear() === y))
    .map((ty) => `body:has(#${filterId('life', ty)}:checked) .year-jump a[href="#y${y}"]{display:none}`)))
  .join('');

const fmt = (d: Date) =>
  d.toLocaleDateString(L.htmlLang, { year: 'numeric', month: '2-digit', timeZone: 'UTC' });

const items = await Promise.all(
  entries.map(async (e) => ({
    entry: e,
    Content: (await render(e)).Content,
    // Full-size version opened when a thumbnail is clicked
    large: await Promise.all(e.data.photos.map((p) => getImage({ src: p, width: Math.min(p.width, 1800) }))),
  })),
);
---
<Base locale={locale} title={title} wide={hasGlobe}>
<div class:list={['life', { 'with-globe': hasGlobe }]}>
 <div class="life-main">
  <h1>{title}</h1>

  <Filter name="life" allLabel={L.ui.all} attr="type" extraCss={groupRules}
    options={present.map((ty) => ({ value: ty, label: L.ui.lifeTypes[ty] }))} />

  {years.length > 1 && (
    <nav class="year-jump" aria-label={locale === 'zh' ? '跳到年份' : 'Jump to year'}>
      {years.map((y) => <a href={`#y${y}`}>{y}</a>)}
    </nav>
  )}

  <div id="life-list" data-pagefind-body>
  {years.map((y) => (
    <section class="life-year" data-year={y}>
      <h2 class="year" id={`y${y}`}>{y}</h2>
      <ol class="entry-list">
        {items
          .filter(({ entry }) => entry.data.date.getUTCFullYear() === y)
          .map(({ entry, Content, large }) => {
            const d = entry.data;
            return (
              <li class:list={['life-item', `t-${d.type}`, { compact: compact.has(d.type) }]} data-type={d.type}
                data-lat={d.coords?.[0]} data-lng={d.coords?.[1]}>
                <div class="life-meta">
                  <span class="life-type">{L.ui.lifeTypes[d.type]}</span>
                  <time datetime={d.date.toISOString()}>
                    {fmt(d.date)}{d.end ? ` – ${fmt(d.end)}` : d.type === 'city' ? ` – ${L.ui.present}` : ''}
                  </time>
                </div>
                <div class="life-body">
                  <h3>
                    {d.link ? <a href={d.link}>{d.title}</a> : d.title}
                    {d.rating && <span class="rating" aria-label={`${d.rating}/5`}>{'★'.repeat(d.rating)}{'☆'.repeat(5 - d.rating)}</span>}
                  </h3>
                  {d.place && <p class="muted small">{d.place}</p>}
                  <div class="prose"><Content /></div>
                  {d.photos.length > 0 && (
                    <div class="life-photos">
                      {d.photos.map((p, i) => (
                        <a href={large[i].src}>
                          <Image src={p} alt={`${d.title} ${i + 1}`} width={240} height={240} fit="cover" />
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            );
          })}
      </ol>
    </section>
  ))}
  </div>
 </div>
 {hasGlobe && (
   <aside class="globe-wrap">
     <canvas id="globe" aria-label={locale === 'zh' ? '地球：点击地点跳到对应条目，拖动旋转，放大后展开成平面地图' : 'Globe: click a place to jump to its entries, drag to turn, zoom in to unfold it into a flat map'}></canvas>
     <div class="globe-zoom" id="globe-zoom">
       <button type="button" data-zoom="in" aria-label={locale === 'zh' ? '放大' : 'Zoom in'}>+</button>
       <button type="button" data-zoom="out" aria-label={locale === 'zh' ? '缩小' : 'Zoom out'}>−</button>
       <button type="button" data-zoom="reset" aria-label={locale === 'zh' ? '回到地球' : 'Back to globe'}>◯</button>
     </div>
   </aside>
 )}
</div>
</Base>

<script>
  import { initGlobe } from '../../../scripts/globe';
  const canvas = document.getElementById('globe') as HTMLCanvasElement | null;
  const list = document.getElementById('life-list');
  if (canvas && list) initGlobe(canvas, list, document.getElementById('globe-zoom'));
</script>

<style>
  .life.with-globe { display: grid; grid-template-columns: minmax(0, var(--content-width)) minmax(14rem, 1fr); gap: 2.5rem; align-items: start; }
  .life-main { min-width: 0; }
  .globe-wrap { position: sticky; top: 4.5rem; }
  #globe { display: block; width: 100%; max-width: 22rem; aspect-ratio: 1; margin: 0 auto; touch-action: none; cursor: grab; border-radius: var(--radius); }
  .globe-zoom { display: flex; justify-content: center; gap: 0.4rem; margin-top: 0.5rem; }
  .globe-zoom button {
    width: 2rem; height: 2rem; border: 1px solid var(--border); border-radius: 999px; background: var(--bg);
    color: var(--muted); font: inherit; font-size: 1rem; line-height: 1; cursor: pointer;
  }
  .globe-zoom button:hover { color: var(--fg); border-color: var(--muted); }
  @media (max-width: 52rem) {
    .life.with-globe { grid-template-columns: 1fr; gap: 0; }
    .globe-wrap { position: static; order: -1; padding-top: 0.5rem; }
    #globe { max-width: 15rem; }
  }

  .year-jump { display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; font-size: 0.875rem; font-variant-numeric: tabular-nums; margin: -0.25rem 0 0.5rem; }
  .year-jump a { color: var(--muted); text-decoration: none; }
  .year-jump a:hover { color: var(--accent); }

  .life-item { transition: background-color 0.4s; }
  .life-item.on-globe .life-type { text-decoration: underline; text-underline-offset: 0.25em; }
  .life-item.picked { background: var(--code-bg); }


  .life-item { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; padding-inline: 0.5rem; }
  .life-item.compact .life-body h3 { font-weight: 500; }
  .life-item.compact .prose { color: var(--muted); font-size: 0.95rem; }
  .life-meta { display: flex; flex-direction: column; font-size: 0.85rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .life-type { color: var(--muted); font-weight: 600; }
  .life-body { min-width: 0; }
  .life-body h3 { margin: 0; font-size: 1.05rem; display: flex; flex-wrap: wrap; gap: 0.25rem 0.75rem; align-items: baseline; }
  .life-body .muted { margin: 0.1rem 0 0; }
  .life-body .prose :global(p) { margin: 0.3rem 0; }
  .rating { color: var(--accent); font-size: 0.85rem; letter-spacing: 0.05em; }
  .life-photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)); gap: 0.4rem; margin-top: 0.6rem; }
  .life-photos img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; }

  @media (max-width: 30rem) {
    .life-item { grid-template-columns: 1fr; gap: 0.2rem; }
    .life-meta { flex-direction: row; gap: 0.75rem; }
  }
</style>


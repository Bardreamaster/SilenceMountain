---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { splitId } from '../../../lib/i18n';
import { translationsOf } from '../../../lib/content';
import site from '../../../site.config';

// Projects with an external `url` get no page here; their card links out instead.
export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.url && !(import.meta.env.PROD && p.data.draft));
  return projects.map((project) => {
    const { locale, slug } = splitId(project.id);
    return { params: { locale: locale === site.defaultLocale ? undefined : locale, slug }, props: { project } };
  });
}
const { project } = Astro.props;
const { locale } = splitId(project.id);
const { Content } = await render(project);
const alternates = await translationsOf('projects', project);
---
<Base locale={locale} title={project.data.title} description={project.data.summary} alternates={alternates}>
  <article data-pagefind-body>
    <header class="post-header">
      <h1>{project.data.title}</h1>
      <div class="meta" data-pagefind-ignore>
        {project.data.tags.length > 0 && <span>{project.data.tags.join(' · ')}</span>}
        <span>{project.data.date.getUTCFullYear()}</span>
      </div>
    </header>
    {project.data.cover && (
      <p><Image src={project.data.cover} alt={project.data.coverAlt ?? project.data.title} widths={[480, 800, 1200]} sizes="(max-width: 44rem) 100vw, 42rem" /></p>
    )}
    <div class="prose"><Content /></div>
  </article>
</Base>
